# Copy to .env for local development. Never commit the real .env.
DATABASE_URL=postgres://remember:password@localhost:5556/remember
JWT_SECRET=dev-only-secret
JWT_TTL=30d
PORT=5001
CLIENT_ORIGIN=http://localhost:3000

# Production only (set these on your host, not here):
# NODE_ENV=production
# JWT_SECRET=<at least 32 characters: openssl rand -hex 32>
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=verify-full
# DATABASE_SSL=true          # on by default in production
# DATABASE_POOL_MAX=5        # keep small on free databases
# TRUST_PROXY_HOPS=1         # one proxy in front of the app on Render
