{
  "name": "remember",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "npm --prefix server start",
    "server": "npm --prefix server run dev",
    "client": "npm run start --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "db": "docker-compose up -d db",
    "test": "npm --prefix server test",
    "build": "npm --prefix server run build && npm run build --prefix client",
    "deploy:build": "npm --prefix server ci --include=dev && npm --prefix client ci --include=dev && npm run build"
  },
  "dependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
